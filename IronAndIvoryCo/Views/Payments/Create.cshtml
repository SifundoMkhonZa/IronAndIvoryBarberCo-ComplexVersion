@model IronAndIvoryCo.Models.Payment
@{
    ViewData["Title"] = "New Payment";
    bool hasAppointment = ViewBag.AppointmentIdValue != null || ViewBag.AppointmentId != null && ViewBag.DefaultAmount != null;
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>RECORD PAYMENT</h1>
        <div class="gold-line"></div>
        <p>Secure transaction for Iron & Ivory Co.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            @if (ViewBag.AppointmentId != null && ViewBag.DefaultAmount != null)
            {
                <div class="alert alert-warning border-0 shadow-sm mb-4" style="border-radius:15px;">
                    <i class="bi bi-info-circle"></i> Paying for <b>Appointment #@ViewBag.AppointmentId</b>
                    @if (ViewBag.CustomerName != null) { <span> - @ViewBag.CustomerName</span> }
                    @if (ViewBag.ServiceName != null) { <span>(@ViewBag.ServiceName)</span> }<br/>
                    <b>Due: R @ViewBag.DefaultAmount</b>
                </div>
            }

            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="fw-bold small">AMOUNT (R) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-warning fw-bold">R</span>
                                <input asp-for="Amount" class="form-control" placeholder="350.00" type="number" step="0.01" id="Amount" value="@(ViewBag.DefaultAmount ?? "")" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="fw-bold small">PAYMENT DATE *</label>
                            <input asp-for="PaymentDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="paymentMethod" class="fw-bold small">METHOD *</label>
                            <select asp-for="paymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.paymentMethod>()"></select>
                            <span asp-validation-for="paymentMethod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentStatus" class="fw-bold small">STATUS *</label>
                            <select asp-for="PaymentStatus" class="form-select" asp-items="Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.PaymentStatus>()"></select>
                            <span asp-validation-for="PaymentStatus" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentId" class="fw-bold small">LINKED APPOINTMENT</label>
                            <select asp-for="AppointmentId" class="form-select" asp-items="ViewBag.AppointmentId" id="AppointmentId">
                                <option value="">-- No Appointment --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SaleId" class="fw-bold small">LINKED SALE</label>
                            <select asp-for="SaleId" class="form-select" asp-items="ViewBag.SaleId">
                                <option value="">-- No Sale --</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="bg-light rounded-3 p-3 d-flex gap-2 align-items-center small">
                                <i class="bi bi-shield-lock fs-4 text-success"></i>
                                <span>Payment will be recorded securely. Appointment will be auto-confirmed and marked <b>PAID</b>.</span>
                            </div>
                        </div>

                        <div class="col-12 mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-credit-card"></i> CONFIRM PAYMENT</button>
                            <a asp-action="Index" asp-controller="Appointments" class="btn btn-dark px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Auto-set amount if coming from appointment
        @if (ViewBag.DefaultAmount != null)
        {
            <text>
            document.getElementById('Amount').value = '@ViewBag.DefaultAmount';
            </text>
        }
        @if (ViewBag.AppointmentId != null && ViewBag.AppointmentId is int)
        {
            <text>
            document.getElementById('AppointmentId').value = '@ViewBag.AppointmentId';
            </text>
        }
    </script>
}