@model IronAndIvoryCo.Models.Payment
@{
    ViewData["Title"] = "Edit Payment";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>EDIT PAYMENT #@Model.PaymentId.ToString().PadLeft(5,'0')</h1>
        <div class="gold-line"></div>
        <p>R @Model.Amount.ToString("F2") • @Model.paymentMethod</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="PaymentId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="fw-bold small">AMOUNT (R) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-warning fw-bold">R</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="fw-bold small">DATE *</label>
                            <input asp-for="PaymentDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="paymentMethod" class="fw-bold small">METHOD *</label>
                            <select asp-for="paymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.paymentMethod>()"></select>
                            <span asp-validation-for="paymentMethod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentStatus" class="fw-bold small">STATUS *</label>
                            <select asp-for="PaymentStatus" class="form-select" asp-items="Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.PaymentStatus>()"></select>
                            <span asp-validation-for="PaymentStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentId" class="fw-bold small">APPOINTMENT</label>
                            <select asp-for="AppointmentId" class="form-select" asp-items="ViewBag.AppointmentId"></select>
                            <span asp-validation-for="AppointmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SaleId" class="fw-bold small">SALE</label>
                            <select asp-for="SaleId" class="form-select" asp-items="ViewBag.SaleId"><option value="">-- None --</option></select>
                            <span asp-validation-for="SaleId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-check-lg"></i> SAVE CHANGES</button>
                            <a asp-action="Details" asp-route-id="@Model.PaymentId" class="btn btn-dark-custom px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}