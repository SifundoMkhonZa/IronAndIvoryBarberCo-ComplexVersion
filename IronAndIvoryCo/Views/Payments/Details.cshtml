@using IronAndIvoryCo.Models.Enums
@model IronAndIvoryCo.Models.Payment
@{
    ViewData["Title"] = $"Payment R{Model.Amount:F2}";
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">PAYMENT #@Model.PaymentId.ToString().PadLeft(5,'0')</h1>
        <div class="gold-line" style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p>
            <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span> 
            • R @Model.Amount.ToString("F2") 
            • @Model.PaymentDate.ToString("dd MMM yyyy HH:mm")
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-5">
            <div class="ivory-card p-4 text-center shadow-sm" style="border-radius:16px; background:white;">
                <div class="mx-auto mb-3 rounded-circle bg-dark text-warning d-flex align-items-center justify-content-center" style="width:80px;height:80px;">
                    <i class="bi bi-receipt fs-1" style="color:#FFC107;"></i>
                </div>
                <h2 class="fw-bold" style="font-weight:800">R @Model.Amount.ToString("F2")</h2>
                <p class="text-muted small">@Model.PaymentDate.ToString("dddd, dd MMMM yyyy HH:mm")</p>
                <hr/>
                <div class="text-start small">
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Method</span><strong><i class="bi bi-credit-card"></i> @Model.paymentMethod</strong></div>
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Status</span><span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span></div>
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Appointment</span><strong>#@Model.AppointmentId</strong></div>
                    <div class="d-flex justify-content-between py-2"><span class="text-muted">Sale</span><strong>@(Model.SaleId != null ? "#"+Model.SaleId : "—")</strong></div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-gold flex-grow-1 fw-bold" style="background:#FFC107; color:#111; font-weight:800; border-radius:10px; padding:10px; text-decoration:none;"><i class="bi bi-pencil"></i> Edit</a>
                    }
                    <a asp-action="Index" class="btn btn-dark-custom flex-grow-1" style="background:#111; color:white; border-radius:10px; padding:10px; text-decoration:none; text-align:center;">Back</a>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ivory-card p-4 shadow-sm" style="border-radius:16px; background:white;">
                <h6 class="fw-bold"><i class="bi bi-shield-check"></i> TRANSACTION INFO</h6>
                <div class="bg-light rounded-3 p-3 small mt-3">
                    <p class="mb-2">✓ Payment recorded securely<br/>✓ Receipt sent to customer<br/>✓ Loyalty points credited</p>
                    <button onclick="window.print()" class="btn btn-outline-dark btn-sm w-100 mt-2" style="border-radius:8px;"><i class="bi bi-printer"></i> Print Receipt</button>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete" asp-route-id="@Model.PaymentId" class="btn btn-outline-danger w-100 mt-3 btn-sm" style="border-radius:8px;"><i class="bi bi-trash"></i> Void Payment</a>
                }
                @if (Model.AppointmentId != null)
                {
                    <a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-outline-dark w-100 mt-2 btn-sm" style="border-radius:8px;"><i class="bi bi-calendar"></i> View Appointment</a>
                }
            </div>
        </div>
    </div>
</div>