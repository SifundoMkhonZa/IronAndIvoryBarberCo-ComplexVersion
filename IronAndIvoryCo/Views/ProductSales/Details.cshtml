@model IronAndIvoryCo.Models.ProductSale
@{
    ViewData["Title"] = $"Sale Item #{Model.ProductSaleId}";
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">SALE ITEM #@Model.ProductSaleId</h1>
        <div class="gold-line" style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p class="text-white-50 mb-0">@Model.Product?.ProductName • @Model.Quantity x R @Model.UnitPrice.ToString("F2")</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
            <div class="ivory-card overflow-hidden shadow-sm" style="border-radius:16px; background:white;">
                <div style="height:180px;background:#111;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-bag-check fs-1 text-warning" style="color:#FFC107 !important;"></i>
                </div>
                <div class="ivory-body p-4">
                    <h5 class="fw-bold">@Model.Product?.ProductName</h5>
                    <small class="text-muted">@Model.Product?.Brand • @Model.Product?.Category</small>
                    <hr/>
                    <div class="small">
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Sale Invoice</span><strong>#@Model.SaleId.ToString().PadLeft(5,'0')</strong></div>
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Quantity</span><strong>@Model.Quantity</strong></div>
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Unit Price</span><strong>R @Model.UnitPrice.ToString("F2")</strong></div>
                        <div class="d-flex justify-content-between py-2"><span class="text-muted">Line Total</span><strong class="fs-5 text-success">R @((Model.Quantity * Model.UnitPrice).ToString("F2"))</strong></div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.ProductSaleId" class="btn btn-gold flex-grow-1 fw-bold" style="background:#FFC107; color:#111; font-weight:800; border-radius:10px; padding:10px; text-decoration:none;"><i class="bi bi-pencil"></i> Edit</a>
                        }
                        <a asp-action="Index" class="btn btn-dark-custom flex-grow-1" style="background:#111; color:white; border-radius:10px; padding:10px; text-decoration:none; text-align:center;">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>