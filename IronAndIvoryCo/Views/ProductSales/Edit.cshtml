@model IronAndIvoryCo.Models.ProductSale
@{
    ViewData["Title"] = "Edit Sale Item";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>EDIT ITEM #@Model.ProductSaleId</h1>
        <div class="gold-line"></div>
        <p>@Model.Product?.ProductName • R @Model.UnitPrice.ToString("F2")</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ProductSaleId" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ProductId" class="fw-bold small">PRODUCT *</label>
                            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId"></select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="fw-bold small">QUANTITY *</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" id="qty" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="fw-bold small">UNIT PRICE *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-warning">R</span>
                                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" id="price" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SaleId" class="fw-bold small">SALE INVOICE *</label>
                            <select asp-for="SaleId" class="form-select" asp-items="ViewBag.SaleId"></select>
                        </div>
                        <div class="col-12">
                            <div class="bg-dark rounded-3 p-3 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">LINE TOTAL</span>
                                <strong class="text-warning fs-5" id="lineTotal">R @((Model.Quantity * Model.UnitPrice).ToString("F2"))</strong>
                            </div>
                        </div>
                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-check-lg"></i> SAVE</button>
                            <a asp-action="Index" class="btn btn-dark-custom px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calc(){ let q=parseFloat(document.getElementById('qty').value)||0; let p=parseFloat(document.getElementById('price').value)||0; document.getElementById('lineTotal').innerText='R '+(q*p).toFixed(2); }
        document.getElementById('qty').addEventListener('input',calc); document.getElementById('price').addEventListener('input',calc);
    </script>
}