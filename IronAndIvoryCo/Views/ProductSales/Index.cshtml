@model IEnumerable<IronAndIvoryCo.Models.Product>
@{
    ViewData["Title"] = "Products";
}
<div class="banner-black">
    <h1>PREMIUM GROOMING PRODUCTS</h1>
    <p>PROFESSIONAL-GRADE PRODUCTS USED BY OUR BARBERS</p>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold">@Model.Count() Products</h5>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-create-gold">+ Add Product</a>
        }
    </div>

    <div class="row g-4">
    @foreach(var item in Model){
        <div class="col-md-4">
            <div class="card-service">
                <div class="img-wrap">
                    <span class="badge-gold">R @item.Price.ToString("F2")</span>
                    @if(!string.IsNullOrEmpty(item.ImageUrl)){
                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                    } else {
                        <img src="https://via.placeholder.com/400x220?text=No+Image" />
                    }
                </div>
                <div class="p-3">
                    <h6 class="fw-bold mb-1">@item.ProductName</h6>
                    <small class="text-muted">@item.Brand</small>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="price">R @item.Price.ToString("F2")</span>
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn-book btn-sm">View</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-dark btn-sm" style="border-radius:8px;">Edit</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>