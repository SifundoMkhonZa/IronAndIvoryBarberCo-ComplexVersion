@model IronAndIvoryCo.Models.ProductSale
@{
    ViewData["Title"] = "Add Sale Item";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>ADD PRODUCT TO SALE</h1>
        <div class="gold-line"></div>
        <p>Retail transaction for Iron & Ivory Co.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Create" id="saleForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ProductId" class="fw-bold small">PRODUCT *</label>
                            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId" id="productSelect"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="fw-bold small">QUANTITY *</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" value="1" id="qty" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="fw-bold small">UNIT PRICE (R) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-warning fw-bold">R</span>
                                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" id="price" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SaleId" class="fw-bold small">SALE / INVOICE *</label>
                            <select asp-for="SaleId" class="form-select" asp-items="ViewBag.SaleId"></select>
                        </div>

                        <div class="col-12">
                            <div class="bg-dark rounded-3 p-3 d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted small">LINE TOTAL</span>
                                <strong class="text-warning fs-5" id="lineTotal">R 0.00</strong>
                            </div>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-bag-plus"></i> ADD TO SALE</button>
                            <a asp-action="Index" class="btn btn-dark-custom px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calc(){ 
            let q = parseFloat(document.getElementById('qty').value) || 0;
            let p = parseFloat(document.getElementById('price').value) || 0;
            document.getElementById('lineTotal').innerText = 'R ' + (q*p).toFixed(2);
        }
        document.getElementById('qty').addEventListener('input', calc);
        document.getElementById('price').addEventListener('input', calc);
    </script>
}
