@model IronAndIvoryCo.Models.ProductSale
@{
    ViewData["Title"] = "Remove Sale Item";
}

<div class="page-hero" style="background:#2a0a0a;">
    <div class="container">
        <h1>REMOVE ITEM</h1>
        <div class="gold-line"></div>
        <p class="text-danger">This will affect inventory & revenue</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="ivory-card text-center">
                <div class="ivory-body">
                    <div class="mx-auto mb-3 rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width:70px;height:70px;">
                        <i class="bi bi-bag-x fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Remove @Model.Product?.ProductName?</h5>
                    <p class="text-muted small">Sale #@Model.SaleId • Qty @Model.Quantity • R @Model.UnitPrice.ToString("F2")</p>

                    <div class="bg-light rounded-3 p-3 small text-start mb-4">
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Product</span><strong>@Model.Product?.ProductName (@Model.Product?.Brand)</strong></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Qty x Price</span><strong>@Model.Quantity x R @Model.UnitPrice.ToString("F2")</strong></div>
                        <div class="d-flex justify-content-between py-1 border-top mt-1 pt-2"><span class="text-muted">Line Total</span><strong class="text-success">R @((Model.Quantity * Model.UnitPrice).ToString("F2"))</strong></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ProductSaleId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1 fw-bold py-2"><i class="bi bi-trash"></i> Remove</button>
                            <a asp-action="Index" class="btn btn-dark-custom flex-grow-1 py-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>