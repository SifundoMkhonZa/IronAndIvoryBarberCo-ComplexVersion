@model IronAndIvoryCo.Models.Customer
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">@Model.Name.ToUpper()</h1>
        <div class="gold-line" style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p class="text-white-50 mb-0"><i class="bi bi-star-fill" style="color:#FFC107;"></i> @Model.LoyaltyPoints Loyalty Points • Member since @Model.CreatedDate.ToString("MMM yyyy")</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-4">
            <div class="ivory-card text-center p-4 shadow-sm" style="border-radius:16px; background:white;">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width:90px;height:90px;background:#111;color:#FFC107;font-weight:800;font-size:2.2rem;">@Model.Name.Substring(0,1)</div>
                <h4 class="fw-bold" style="font-weight:800">@Model.Name</h4>
                <p class="text-muted small">@Model.Email<br/>@Model.Phone</p>
                <div class="bg-dark text-warning rounded-pill py-2 px-3 d-inline-block fw-bold" style="background:#111 !important; color:#FFC107 !important;"><i class="bi bi-trophy"></i> @Model.LoyaltyPoints POINTS</div>
                <hr/>
                <div class="text-start small">
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Gender</span><strong>@Model.Gender</strong></div>
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">DOB</span><strong>@Model.DateOfBirth.ToString("dd MMM yyyy")</strong></div>
                    <div class="d-flex justify-content-between py-2"><span class="text-muted">Joined</span><strong>@Model.CreatedDate.ToString("dd MMM yyyy")</strong></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="ivory-card p-4 shadow-sm" style="border-radius:16px; background:white;">
                <h6 class="fw-bold"><i class="bi bi-calendar-check"></i> APPOINTMENT HISTORY</h6>
                <div class="text-center py-5 text-muted small">
                    <i class="bi bi-calendar fs-2"></i><br/>
                    Load appointments via ViewBag or Include in controller
                </div>
                <div class="d-flex gap-2 mt-3">
                    @if (User.IsInRole("Admin") || User.Identity?.Name == Model.Email)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold flex-grow-1 fw-bold" style="background:#FFC107; color:#111; font-weight:800; border-radius:10px; padding:10px; text-decoration:none;"><i class="bi bi-pencil"></i> Edit Profile</a>
                    }
                    <a asp-action="Index" class="btn btn-dark-custom flex-grow-1" style="background:#111; color:white; border-radius:10px; padding:10px; text-decoration:none; text-align:center;">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
