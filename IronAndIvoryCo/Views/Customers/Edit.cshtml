@model IronAndIvoryCo.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>EDIT: @Model.Name.ToUpper()</h1>
        <div class="gold-line"></div>
        <p>@Model.Email • @Model.LoyaltyPoints points</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="fw-bold small">FULL NAME *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="fw-bold small">EMAIL *</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="fw-bold small">PHONE *</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="fw-bold small">DOB</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="fw-bold small">GENDER</label>
                            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.Gender>()"></select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LoyaltyPoints" class="fw-bold small">LOYALTY POINTS</label>
                            <input asp-for="LoyaltyPoints" class="form-control" />
                            <span asp-validation-for="LoyaltyPoints" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-check-lg"></i> SAVE CHANGES</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-dark-custom px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
