@model IronAndIvoryCo.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<div class="page-hero" style="background:#2a0a0a;">
    <div class="container">
        <h1>DELETE CUSTOMER</h1>
        <div class="gold-line"></div>
        <p class="text-danger">This action cannot be undone</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="ivory-card">
                <div class="ivory-img-wrap" style="height:180px; background:#111; display:flex; align-items:center; justify-content:center; flex-direction:column; color:white;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mb-2" style="width:70px;height:70px;background:#FFC107;color:#111;font-weight:800;font-size:1.8rem;">@Model.Name.Substring(0,1)</div>
                    <h4 class="fw-bold" style="font-weight:800">@Model.Name</h4>
                    <small class="text-muted">@Model.Email</small>
                </div>
                <div class="ivory-body">
                    <div class="alert alert-danger d-flex gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            <strong>Remove @Model.Name?</strong><br/>
                            <small>Customer with @Model.LoyaltyPoints loyalty points and all appointments will be affected.</small>
                        </div>
                    </div>

                    <div class="bg-light rounded-3 p-3 small mb-4">
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Phone</span><strong>@Model.Phone</strong></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Member Since</span><strong>@Model.CreatedDate.ToString("dd MMM yyyy")</strong></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Points</span><strong class="text-warning">@Model.LoyaltyPoints pts</strong></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1 fw-bold py-2"><i class="bi bi-trash"></i> Yes, Delete Customer</button>
                            <a asp-action="Index" class="btn btn-dark-custom flex-grow-1 py-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
