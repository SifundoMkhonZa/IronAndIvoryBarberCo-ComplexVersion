@model IronAndIvoryCo.Models.Admin
@{
    ViewData["Title"] = "Edit Admin";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>EDIT ADMIN</h1>
        <div class="gold-line"></div>
        <p>@Model.Name • @Model.Email</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-card" style="background:white; border-radius:16px; padding:35px; box-shadow:0 15px 40px rgba(0,0,0,0.08); border:1px solid #eee;">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="fw-bold small">FULL NAME *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AccessCode" class="fw-bold small">ACCESS CODE *</label>
                            <input asp-for="AccessCode" class="form-control" style="letter-spacing:1px; font-weight:700; background:#fffbe6; border-color:#FFC107;" />
                            <span asp-validation-for="AccessCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="fw-bold small">EMAIL *</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="fw-bold small">PHONE *</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-2">
                            <small class="text-muted">Created: @Model.CreatedDate.ToString("dd MMM yyyy HH:mm") • Staff Managed: @(Model.StaffMembers?.Count() ?? 0)</small>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold px-4 fw-bold"><i class="bi bi-check-lg"></i> Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-dark-custom px-4">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}