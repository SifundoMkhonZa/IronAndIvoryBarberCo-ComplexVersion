@model IronAndIvoryCo.Models.Admin
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">@Model.Name?.ToUpper()</h1>
        <div class="gold-line" style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p class="text-white-50 mb-0"><i class="bi bi-shield-lock"></i> Admin • Access Code: @Model.AccessCode</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">

        <div class="col-lg-4">
            <div class="ivory-card p-4 text-center shadow-sm" style="border-radius:16px; background:white;">
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:120px;height:120px;background:#1E2126;color:#FFC107;font-weight:800;font-size:2.5rem;">
                    @(Model.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <h4 class="fw-bold" style="font-weight:800">@Model.Name</h4>
                <span class="badge bg-warning text-dark rounded-pill mb-3" style="background:#FFC107 !important;">
                    <i class="bi bi-shield-check"></i> Admin
                </span>

                <div class="text-start mt-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Email</span>
                        <strong class="small">@Model.Email</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Phone</span>
                        <strong>@Model.Phone</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Access Code</span>
                        <strong style="color:#D4AF37;">@Model.AccessCode</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Created</span>
                        <strong>@Model.CreatedDate.ToString("dd MMM yyyy")</strong>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold w-50 fw-bold" style="background:#FFC107; color:#111; font-weight:800; border-radius:10px; padding:10px; text-decoration:none;">
                            Edit
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-dark-custom w-50" style="background:#111; color:white; border-radius:10px; padding:10px; text-decoration:none; text-align:center;">
                        Back
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ivory-card p-4 shadow-sm" style="border-radius:16px; background:white;">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-scissors"></i>
                    BARBERS MANAGED
                    (@(Model.StaffMembers?.OfType<IronAndIvoryCo.Models.Barber>().Count() ?? 0))
                </h6>
                @if (Model.StaffMembers != null && Model.StaffMembers.OfType<IronAndIvoryCo.Models.Barber>().Any())
                {
                    foreach (var staff in Model.StaffMembers.OfType<IronAndIvoryCo.Models.Barber>())
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <strong>@staff.Name</strong><br />
                                <small class="text-muted">@staff.Role • @staff.Speciality</small>
                            </div>
                            <span class="badge bg-light text-dark border">@staff.BranchId</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-people fs-2"></i><br />No barbers assigned yet
                    </div>
                }
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-3">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger w-100" style="border-radius:10px;">
                        <i class="bi bi-trash"></i> Delete Admin
                    </a>
                </div>
            }
        </div>
    </div>
</div>




