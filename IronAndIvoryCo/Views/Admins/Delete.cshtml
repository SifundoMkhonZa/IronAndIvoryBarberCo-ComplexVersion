@model IronAndIvoryCo.Models.Admin
@{
    ViewData["Title"] = "Delete Admin";
}

<div class="page-hero" style="background:#2a0a0a;">
    <div class="container">
        <h1>DELETE ADMIN</h1>
        <div class="gold-line"></div>
        <p class="text-danger">This action cannot be undone</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="ivory-card">
                <div class="p-4 text-center border-bottom">
                    <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width:80px;height:80px;background:#1E2126;color:#FFC107;font-weight:800;font-size:2rem;">
                        @(Model.Name?.Substring(0,1).ToUpper() ?? "A")
                    </div>
                    <h4 class="fw-bold" style="font-weight:800">@Model.Name</h4>
                    <p class="text-muted small">@Model.Email</p>
                    <span class="badge bg-dark rounded-pill"><i class="bi bi-shield-lock"></i> Access: @Model.AccessCode</span>
                </div>
                <div class="ivory-body">
                    <div class="alert alert-danger d-flex gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            <strong>Delete this admin?</strong><br/>
                            <small>This will remove <b>@Model.Name</b> and they will lose access to admin panel. Staff members created by them will remain.</small>
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-4 small">
                        <div class="d-flex justify-content-between"><span class="text-muted">Name:</span><strong>@Model.Name</strong></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">Email:</span><strong>@Model.Email</strong></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">Phone:</span><strong>@Model.Phone</strong></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">Created:</span><strong>@Model.CreatedDate.ToString("dd MMM yyyy")</strong></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1 fw-bold py-2"><i class="bi bi-trash"></i> Yes, Delete</button>
                            <a asp-action="Index" class="btn btn-dark-custom px-4 py-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
