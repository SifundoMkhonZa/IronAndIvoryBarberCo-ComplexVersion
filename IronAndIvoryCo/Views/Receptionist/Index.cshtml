@model IEnumerable<IronAndIvoryCo.Models.Receptionist>
@{
    ViewData["Title"] = "Reception Team";
}
<div class="page-hero" style="background:#111;">
    <div class="container d-flex justify-content-between align-items-end flex-wrap">
        <div><h1>RECEPTION TEAM</h1><div class="gold-line"></div><p>@Model.Count() staff managing front desk</p></div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-gold px-4 fw-bold mb-2"><i class="bi bi-person-plus"></i> Add Receptionist</a>
        }
    </div>
</div>
<div class="container py-5">
    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <div class="row g-4">
        @foreach(var r in Model){
            <div class="col-md-4">
                <div class="ivory-card p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:70px;height:70px;border-radius:50%;background:#111;color:#D4AF37;font-weight:800;font-size:1.5rem">@r.Name.Substring(0,1)</div>
                    <h5 class="fw-bold mb-1">@r.Name</h5>
                    <small class="text-muted">@r.Branch?.BranchName • Desk @r.DeskNumber</small><br/>
                    <span class="badge bg-warning text-dark mt-2">@r.Shift</span>
                    <div class="mt-3 small"><i class="bi bi-telephone"></i> @r.Phone<br/><i class="bi bi-envelope"></i> @r.Email</div>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="btn-group btn-group-sm mt-3 w-100">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-dark"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-dark btn-sm w-100">View Profile</a>
                        </div>
                    }
                </div>
            </div>
        }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center py-4">
            <i class="bi bi-shield-lock fs-2"></i>
            <h5 class="mt-2">Access Restricted</h5>
            <p class="mb-0">Only Admin and Reception staff can view reception team.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark mt-3">Go Home</a>
        </div>
    }
</div>
