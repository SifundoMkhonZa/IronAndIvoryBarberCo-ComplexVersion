@model IronAndIvoryCo.Models.Branch
@{
    ViewData["Title"] = "Delete Branch";
}

<div class="page-hero" style="background:#2a0a0a;">
    <div class="container">
        <h1>DELETE BRANCH</h1>
        <div class="gold-line"></div>
        <p class="text-danger">This action cannot be undone</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="ivory-card">
                <div class="ivory-img-wrap" style="height:180px; background:#111; display:flex; align-items:center; justify-content:center; flex-direction:column; color:white;">
                    <i class="bi bi-geo-alt-fill display-4 text-warning"></i>
                    <h4 class="fw-bold mt-2" style="font-weight:800">@Model.BranchName</h4>
                    <small class="text-muted">@Model.City</small>
                </div>
                <div class="ivory-body">
                    <div class="alert alert-danger d-flex gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            <strong>Are you sure?</strong><br/>
                            <small>Branch <b>@Model.BranchName</b> at <b>@Model.Address</b> will be removed. All associated barbers & appointments will lose branch link.</small>
                        </div>
                    </div>

                    <div class="bg-light rounded-3 p-3 small mb-4">
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Name</span><strong>@Model.BranchName</strong></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Address</span><strong>@Model.Address, @Model.City</strong></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Hours</span><strong>@Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm")</strong></div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="BranchId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1 fw-bold py-2"><i class="bi bi-trash"></i> Yes, Delete Branch</button>
                            <a asp-action="Index" class="btn btn-dark-custom flex-grow-1 py-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>