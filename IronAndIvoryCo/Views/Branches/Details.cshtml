@model IronAndIvoryCo.Models.Branch
@{
    ViewData["Title"] = Model.BranchName;
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">@Model.BranchName.ToUpper()</h1>
        <div class="gold-line" style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p class="text-white-50 mb-0"><i class="bi bi-geo-alt"></i> @Model.Address, @Model.City • @Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm")</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="ivory-card p-0 overflow-hidden shadow-sm" style="border-radius:16px; background:white;">
                <div style="height:300px; background:#1E2126; display:flex; align-items:center; justify-content:center; flex-direction:column; color:white;">
                    <i class="bi bi-geo-alt-fill display-1" style="color:#FFC107;"></i>
                    <h3 class="fw-bold mt-3" style="font-weight:800">@Model.BranchName</h3>
                    <p class="text-muted">@Model.City</p>
                </div>
                <div class="ivory-body p-4">
                    <div class="row g-3 small">
                        <div class="col-6">
                            <div class="bg-light rounded p-3 text-center">
                                <i class="bi bi-clock fs-4" style="color:#FFC107;"></i><br/>
                                <strong>Opening</strong><br/>@Model.OpeningTime.ToString(@"hh\:mm")
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light rounded p-3 text-center">
                                <i class="bi bi-moon fs-4" style="color:#FFC107;"></i><br/>
                                <strong>Closing</strong><br/>@Model.ClosingTime.ToString(@"hh\:mm")
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Address</span><strong>@Model.Address</strong></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">City</span><strong>@Model.City</strong></div>
                            <div class="d-flex justify-content-between py-2"><span class="text-muted">Status</span><span class="badge bg-success">Open Today</span></div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.BranchId" class="btn btn-gold flex-grow-1 fw-bold" style="background:#FFC107; color:#111; font-weight:800; border-radius:10px; padding:10px; text-decoration:none;"><i class="bi bi-pencil"></i> Edit Branch</a>
                        }
                        <a asp-action="Index" class="btn btn-dark-custom flex-grow-1" style="background:#111; color:white; border-radius:10px; padding:10px; text-decoration:none; text-align:center;">Back to Branches</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ivory-card p-4 shadow-sm" style="border-radius:16px; background:white;">
                <h6 class="fw-bold"><i class="bi bi-people"></i> STAFF AT THIS BRANCH</h6>
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-person-badge fs-2"></i><br/>
                    Branch staff list coming from controller via ViewBag<br/>
                    <small>Show barbers count here</small>
                </div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-3">
                    <a asp-action="Delete" asp-route-id="@Model.BranchId" class="btn btn-outline-danger w-100" style="border-radius:10px;"><i class="bi bi-trash"></i> Delete Branch</a>
                </div>
            }
        </div>
    </div>
</div>