@model IEnumerable<IronAndIvoryCo.Models.Branch>
@{
    ViewData["Title"] = "Our Branches";
}

<div class="page-hero" style="background:#111;">
    <div class="container d-flex justify-content-between align-items-end flex-wrap">
        <div>
            <h1>OUR LOCATIONS</h1>
            <div class="gold-line"></div>
            <p>@Model.Count() premium branches • Open 7 days a week</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-gold px-4 py-2 fw-bold mb-2"><i class="bi bi-plus-lg"></i> Add Branch</a>
        }
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="ivory-card h-100 p-0 overflow-hidden">
                    <div style="height:160px; background:linear-gradient(135deg,#111 0%,#333 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; color:white; position:relative;">
                        <i class="bi bi-geo-alt-fill display-4 text-warning"></i>
                        <h5 class="fw-bold mt-2" style="font-weight:800; letter-spacing:0.5px;">@item.BranchName.ToUpper()</h5>
                        <span class="badge bg-warning text-dark rounded-pill" style="font-size:0.65rem;">@item.City</span>
                        <div style="position:absolute; top:12px; right:12px;" class="bg-success rounded-pill px-2 py-1 small" style="font-size:0.6rem;">● OPEN</div>
                    </div>
                    <div class="ivory-body">
                        <div class="small mb-3">
                            <div class="d-flex gap-2 mb-1"><i class="bi bi-geo-alt text-warning"></i><span>@item.Address, @item.City</span></div>
                            <div class="d-flex gap-2"><i class="bi bi-clock text-warning"></i><span>@item.OpeningTime.ToString(@"hh\:mm") - @item.ClosingTime.ToString(@"hh\:mm")</span></div>
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@item.BranchId" class="btn btn-dark btn-sm flex-grow-1"><i class="bi bi-eye"></i> Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.BranchId" class="btn btn-outline-dark btn-sm flex-grow-1"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.BranchId" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-geo display-1 text-muted"></i>
            <h4 class="mt-3">No Branches Yet</h4>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-gold mt-2">Add First Branch</a>
            }
        </div>
    }
</div>