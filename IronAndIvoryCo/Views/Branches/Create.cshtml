@model IronAndIvoryCo.Models.Branch
@{
    ViewData["Title"] = "Add Branch";
}

<div class="page-hero" style="background:#111;">
    <div class="container">
        <h1>NEW BRANCH</h1>
        <div class="gold-line"></div>
        <p>Expand Iron & Ivory Co. footprint</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-card" style="background:white; border-radius:20px; padding:40px; box-shadow:0 20px 50px rgba(0,0,0,0.08); border:1px solid #eee;">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;background:#111;color:#FFC107;"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                    <div>
                        <h4 class="fw-bold mb-0" style="font-weight:800">BRANCH DETAILS</h4>
                        <small class="text-muted">Add location, hours & city</small>
                    </div>
                </div>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="BranchName" class="fw-bold small">BRANCH NAME *</label>
                            <input asp-for="BranchName" class="form-control" placeholder="e.g. Sandton City, Umhlanga Rocks" />
                            <span asp-validation-for="BranchName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Address" class="fw-bold small">STREET ADDRESS *</label>
                            <input asp-for="Address" class="form-control" placeholder="123 Main Street, Shop 5" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="fw-bold small">CITY *</label>
                            <input asp-for="City" class="form-control" placeholder="Durban" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OpeningTime" class="fw-bold small">OPENING TIME *</label>
                            <input asp-for="OpeningTime" class="form-control" type="time" />
                            <span asp-validation-for="OpeningTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClosingTime" class="fw-bold small">CLOSING TIME *</label>
                            <input asp-for="ClosingTime" class="form-control" type="time" />
                            <span asp-validation-for="ClosingTime" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold"><i class="bi bi-geo-alt"></i> CREATE BRANCH</button>
                            <a asp-action="Index" class="btn btn-dark-custom px-4 py-3">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
