@model IEnumerable<IronAndIvoryCo.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="banner-black" style="background:#111; padding:50px 0; color:white;">
    <div class="container d-flex justify-content-between align-items-end flex-wrap">
        <div>
            <h1 style="font-weight:800; letter-spacing:2px;">PRODUCTS</h1>
            <div style="width:60px; height:4px; background:#D4AF37; margin:10px 0;"></div>
            <p class="text-white-50 mb-0">PREMIUM GROOMING PRODUCTS</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-create-gold mt-3" style="background:#FFC107; color:#111; font-weight:800; padding:10px 20px; border-radius:10px; text-decoration:none;"><i class="bi bi-plus-lg"></i> NEW PRODUCT</a>
        }
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card-service shadow-sm" style="border-radius:16px; overflow:hidden; background:white; border:1px solid #eee; height:100%; display:flex; flex-direction:column;">
                    <div class="img-wrap" style="height:240px; background:#1E2126; position:relative; overflow:hidden;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.ProductName" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 w-100 text-warning">
                                <i class="bi bi-image fs-2"></i>
                            </div>
                        }
                        <span class="badge-gold" style="position:absolute; top:12px; left:12px; background:#FFC107; color:#111; font-weight:800; padding:4px 10px; border-radius:6px; font-size:0.7rem;">IRON & IVORY CO</span>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <small class="text-muted text-uppercase" style="font-size:0.70rem; letter-spacing:1px;">@item.Category • @item.Brand</small>
                        <h6 class="fw-bold mt-1 mb-2" style="font-weight:800; min-height:42px;">@item.ProductName</h6>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span class="price fw-bold" style="font-size:1.2rem; color:#111;">R @item.Price.ToString("F2")</span>
                            <small class="text-muted">Stock: @item.StockQuantity</small>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-dark flex-grow-1" style="border-radius:10px; font-weight:600;">View</a>
                            
                            @if (User.IsInRole("Customer") || User.IsInRole("Admin"))
                            {
                                <form asp-controller="Sales" asp-action="AddToCart" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn w-100 fw-bold" style="background:#111; color:#FFC107; border-radius:10px; font-weight:800;">
                                        <i class="bi bi-bag-plus"></i> Add
                                    </button>
                                </form>
                            }
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mt-2 d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-light w-50 border">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger w-50">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card-service:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(255,193,7,0.20);
        border: 1px solid #FFC107 !important;
    }
    .img-wrap img {
        transition: transform 0.4s ease;
    }
    .card-service:hover .img-wrap img {
        transform: scale(1.06);
    }
</style>