@model IronAndIvoryCo.Models.Schedule
@{
    ViewData["Title"] = "Delete Schedule";
}
<div class="banner-black" style="background:#1a0000;"><h1>DELETE SHIFT?</h1><p>CANNOT BE UNDONE</p></div>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card-form text-center border border-danger">
                <h5 class="fw-bold">@Model.DayOfWeek - @Model.StartTime.ToString(@"hh\:mm") to @Model.EndTime.ToString(@"hh\:mm")</h5>
                <p class="small text-muted">Barber: @Model.Barber?.Name</p>
                <form asp-action="Delete"><input type="hidden" asp-for="ScheduleId" /><div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-danger flex-grow-1 fw-bold" style="border-radius:8px;">YES, DELETE</button><a asp-action="Index" class="btn-book flex-grow-1 text-center">Cancel</a></div></form>
            </div>
        </div>
    </div>
</div>
