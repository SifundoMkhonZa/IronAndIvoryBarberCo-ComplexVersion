@model IronAndIvoryCo.Models.Schedule
@{
    ViewData["Title"] = "Edit Schedule";
}
<div class="banner-black"><h1>EDIT SHIFT</h1><p>@Model.DayOfWeek - @Model.Barber?.Name</p></div>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card-form">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="ScheduleId" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label asp-for="DayOfWeek" class="form-label fw-bold small">DAY</label><select asp-for="DayOfWeek" class="form-select"><option>@Model.DayOfWeek</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>Saturday</option><option>Sunday</option></select></div>
                        <div class="col-md-6"><label asp-for="BarberId" class="form-label fw-bold small">BARBER</label><select asp-for="BarberId" class="form-select" asp-items="ViewBag.BarberId"></select></div>
                    </div>
                    <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="StartTime" class="form-label fw-bold small">START</label><input asp-for="StartTime" class="form-control" type="time" /></div><div class="col-md-6"><label asp-for="EndTime" class="form-label fw-bold small">END</label><input asp-for="EndTime" class="form-control" type="time" /></div></div>
                    <div class="form-check mb-4"><input class="form-check-input" asp-for="IsAvailable" /><label class="form-check-label fw-bold small"> Available</label></div>
                    <div class="d-flex gap-2"><button type="submit" class="btn-create-gold flex-grow-1">SAVE CHANGES</button><a asp-action="Index" class="btn-book flex-grow-1 text-center">Back</a></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
