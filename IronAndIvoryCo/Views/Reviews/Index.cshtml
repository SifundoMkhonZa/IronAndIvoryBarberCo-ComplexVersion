@model IEnumerable<IronAndIvoryCo.Models.Review>
@{
    ViewData["Title"] = "Reviews";
}
<div class="banner-black">
    <h1>CUSTOMER REVIEWS</h1>
    <p>@Model.Count() REVIEWS • AVG @(Model.Any()? Model.Average(r=>r.Rating).ToString("F1") : "0.0") STARS</p>
</div>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold">@Model.Count() Customer Reviews</h5>
        @* Add Review - Customer ONLY, but better to force via MyOrders *@
        @if (User.IsInRole("Customer"))
        {
            <span class="text-muted small">To add a review, go to My Orders → Completed booking → Review</span>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-create-gold">+ Add Review</a>
        }
    </div>
    <div class="row g-4">
    @foreach(var r in Model.OrderByDescending(x=>x.ReviewDate)){
        <div class="col-md-6">
            <div class="card-service p-4">
                <div class="d-flex justify-content-between mb-2">
                    <strong>@r.Customer?.Name</strong>
                    <span class="badge-gold position-static">@r.Rating ★</span>
                </div>
                <p class="fst-italic mb-2">"@r.Comment"</p>
                <small class="text-muted">@r.Barber?.Name • @r.ReviewDate.ToString("dd MMM yyyy")</small>
                <div class="mt-3 d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@r.ReviewId" class="btn-book btn-sm">View</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@r.ReviewId" class="btn btn-outline-danger btn-sm">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
    </div>
</div>
