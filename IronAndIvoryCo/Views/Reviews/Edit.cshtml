@model IronAndIvoryCo.Models.Review
@{
    ViewData["Title"] = "Edit Review";
}
<div class="banner-black">
    <h1>EDIT REVIEW</h1>
    <p>UPDATE CLIENT FEEDBACK</p>
</div>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card-form">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="ReviewId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Rating" class="form-label fw-bold small">RATING *</label>
                        <select asp-for="Rating" class="form-select">
                            <option value="5">★★★★★ 5</option><option value="4">★★★★ 4</option><option value="3">★★★ 3</option><option value="2">★★ 2</option><option value="1">★ 1</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Comment" class="form-label fw-bold small">COMMENT *</label>
                        <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6"><label asp-for="BarberId" class="form-label fw-bold small">BARBER</label><select asp-for="BarberId" class="form-select" asp-items="ViewBag.BarberId"></select></div>
                        <div class="col-md-6"><label asp-for="CustomerId" class="form-label fw-bold small">CUSTOMER</label><select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select></div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-create-gold flex-grow-1">SAVE CHANGES</button>
                        <a asp-action="Index" class="btn-book flex-grow-1 text-center">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
