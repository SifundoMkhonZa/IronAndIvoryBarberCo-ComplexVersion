@model IronAndIvoryCo.Models.Sale
@{
    ViewData["Title"] = "Delete Sale";
}
<div class="banner-black" style="background:#1a0000;"><h1>DELETE SALE?</h1><p>CANNOT BE UNDONE</p></div>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card-form text-center border border-danger">
                <h5 class="fw-bold">Sale #@Model.SaleId - R @Model.TotalAmount.ToString("N2")</h5>
                <p class="small text-muted">@Model.Customer?.Email • @Model.SaleDate.ToString("dd MMM yyyy")</p>
                <form asp-action="Delete"><input type="hidden" asp-for="SaleId" />
                    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-danger flex-grow-1 fw-bold" style="border-radius:8px;">YES, DELETE</button><a asp-action="Index" class="btn-book flex-grow-1 text-center">Cancel</a></div>
                </form>
            </div>
        </div>
    </div>
</div>