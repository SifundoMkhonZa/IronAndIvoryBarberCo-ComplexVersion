@model IronAndIvoryCo.Models.Sale
@{
    ViewData["Title"] = "Cart";
}

<div class="page-hero" style="background:#111; padding:50px 0; text-align:center; color:white;">
    <div class="container">
        <h1 style="font-weight:800; letter-spacing:2px;">YOUR CART</h1>
        <div style="width:60px; height:4px; background:#D4AF37; margin:15px auto;"></div>
        <p class="text-white-50 mb-0">@(Model?.ProductSales?.Count?? 0) ITEMS • IRON & IVORY CO</p>
    </div>
</div>

<div class="container py-5">
    @if (Model == null || Model.ProductSales == null ||!Model.ProductSales.Any())
    {
        <div class="card-form text-center py-5 shadow-sm" style="border-radius:14px; background:white; padding:40px;">
            <i class="bi bi-bag-x" style="font-size:4rem; color:#ccc"></i>
            <h4 class="mt-3 fw-bold" style="font-weight:800">Your cart is empty</h4>
            <p class="text-muted">Add some premium grooming products</p>
            <a asp-controller="Products" asp-action="Index" class="btn mt-3 px-4 py-2 fw-bold" style="background:#FFC107;color:#111;font-weight:800;padding:10px 24px;border-radius:10px;text-decoration:none;">BROWSE PRODUCTS</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card-form p-0 overflow-hidden shadow-sm" style="border-radius:14px; background:white;">
                    @foreach (var item in Model.ProductSales)
                    {
                        <div class="d-flex gap-3 p-3 border-bottom align-items-center">
                            <img src="@item.Product.ImageUrl" style="width:90px; height:90px; object-fit:cover; border-radius:10px; background:#111" onerror="this.style.background='#111'" />
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1" style="font-weight:800">@item.Product.ProductName</h6>
                                <small class="text-muted text-uppercase" style="font-size:0.7rem">@item.Product.Category • @item.Product.Brand</small>
                                <div class="mt-1 fw-bold">R @item.UnitPrice.ToString("F2")</div>
                            </div>
                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productSaleId" value="@item.ProductSaleId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" class="form-control" style="width:70px; border-radius:8px; text-align:center; font-weight:700" onchange="this.form.submit()" />
                            </form>
                            <div class="fw-bold" style="min-width:80px; text-align:right">R @((item.Quantity * item.UnitPrice).ToString("F2"))</div>
                            <form asp-action="RemoveFromCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productSaleId" value="@item.ProductSaleId" />
                                <button type="submit" class="btn btn-outline-danger border-0"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-form shadow-sm p-4" style="position:sticky; top:20px; border-radius:14px; background:white;">
                    <h5 class="fw-bold mb-3" style="font-weight:800">ORDER SUMMARY</h5>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Subtotal</span><span class="fw-bold">R @Model.TotalAmount.ToString("F2")</span></div>
                    <div class="d-flex justify-content-between mb-3"><span class="text-muted">Delivery</span><span class="text-success fw-bold">FREE</span></div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4"><strong style="font-size:1.2rem">Total</strong><strong style="font-size:1.2rem">R @Model.TotalAmount.ToString("F2")</strong></div>
                    <a asp-action="Checkout" class="btn w-100 py-3 fw-bold text-center" style="background:#FFC107;color:#111;font-weight:800;padding:12px;border-radius:10px;text-decoration:none; display:block;"><i class="bi bi-bag-check"></i> CHECKOUT</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark w-100 mt-2 py-2" style="border-radius:8px">Continue Shopping</a>
                    <div class="mt-3 p-2 bg-light rounded-2 text-center"><small class="text-muted"><i class="bi bi-shield-check"></i> Secure checkout • Premium grooming</small></div>
                </div>
            </div>
        </div>
    }
</div>
