@model IronAndIvoryCo.Models.Service
@{
    ViewData["Title"] = "Edit Service";
}

<div class="banner-black" style="padding: 40px 20px;">
    <h1>EDIT SERVICE</h1>
    <p>Update Service Details</p>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card-form">
                <h4 class="fw-bold mb-4"><span style="color:var(--gold)">|</span> Service Information</h4>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ServiceId" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ServiceCategory" class="form-label fw-bold small text-uppercase"></label>
                            <select asp-for="ServiceCategory" class="form-control" asp-items="@Html.GetEnumSelectList<IronAndIvoryCo.Models.Enums.ServiceCategory>()"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BranchId" class="form-label fw-bold small text-uppercase">Branch</label>
                            <select asp-for="BranchId" class="form-control" asp-items="ViewBag.BranchId"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold small text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-white">R</span>
                                <input asp-for="Price" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DurationInMinutes" class="form-label fw-bold small text-uppercase">Duration (Minutes)</label>
                            <input asp-for="DurationInMinutes" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold small text-uppercase"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the service..."></textarea>
                        </div>

                        <div class="col-12 mt-4 p-3" style="background:#FFF8E1; border-radius:10px; border-left:4px solid #FFC107;">
                            <label class="form-label fw-bold small text-uppercase">Current Image</label><br />
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" width="120" height="120" style="object-fit:cover; border-radius:10px; border:2px solid #FFC107;" />
                            }
                            else
                            {
                                <span class="text-muted small">No image</span>
                            }
                            <div class="mt-3">
                                <label asp-for="ImageFile" class="form-label fw-bold small">Change Image (optional)</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            </div>
                        </div>

                        <div class="col-12 d-flex gap-2 mt-4">
                            <button type="submit" class="btn-book flex-grow-1 py-2" style="font-size:1rem">Save Changes</button>
                            <a asp-action="Index" class="btn btn-outline-dark flex-grow-1 py-2 fw-bold" style="border-radius:8px">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="text-center mt-3">
                <a asp-action="Index" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
