@model IEnumerable<IronAndIvoryCo.Models.Service>
@{
    ViewData["Title"] = "Services & Pricing";
    var isAdmin = User.IsInRole("Admin");
}

<div class="banner-black">
    <h1>SERVICES & PRICING</h1>
    <p>Haircuts • Fades • Beard Trims • Packages • Kids Cuts • Grooming</p>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold m-0">Available Services</h4>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn-create-gold">+ Create New</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-service">
                    <div class="img-wrap">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/400x220?text=No+Image" alt="No Image" />
                        }
                        <span class="badge-gold">@item.DurationInMinutes MIN</span>
                    </div>
                    <div class="p-3">
                        <small class="text-muted text-uppercase fw-bold" style="letter-spacing:1px">@item.ServiceCategory</small>
                        <h5 class="fw-bold mt-1 mb-1 text-uppercase">@item.Name</h5>
                        <small class="text-muted d-block mb-2">@item.Branch?.Address</small>
                        <p class="text-muted" style="font-size:0.9rem; height:42px; overflow:hidden;">
                            @item.Description
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="price">R @item.Price.ToString("F2")</span>
                            <a asp-action="Details" asp-route-id="@item.ServiceId" class="btn-book">Book Now</a>
                        </div>
                        @if (isAdmin)
                        {
                            <hr class="my-3" />
                            <div class="d-flex gap-2 small">
                                <a asp-action="Edit" asp-route-id="@item.ServiceId" class="text-dark fw-bold text-decoration-none">Edit</a> |
                                <a asp-action="Details" asp-route-id="@item.ServiceId" class="text-muted text-decoration-none">Details</a> |
                                <a asp-action="Delete" asp-route-id="@item.ServiceId" class="text-danger text-decoration-none">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
